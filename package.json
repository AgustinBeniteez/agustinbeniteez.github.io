{
  "name": "agustin-benitez-portfolio",
  "version": "1.0.0",
  "description": "Portfolio interactivo estilo cuaderno de campo de Agustín Benítez - Web & Indie Game Developer",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:gh-pages": "ng build --base-href ./",
    "build:docs": "ng build --base-href ./ && powershell -Command \"if (Test-Path docs) { Remove-Item docs -Recurse -Force }; Copy-Item dist/portfolio/browser docs -Recurse -Force\""
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2"
  }
}
